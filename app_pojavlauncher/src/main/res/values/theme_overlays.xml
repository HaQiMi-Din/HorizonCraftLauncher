<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Per-accent theme overlays. BaseActivity.onCreate applies the overlay
        matching the saved accent via getTheme().applyStyle(), so every
        ?attr/colorPrimary / colorOnPrimary / ... resolves to the selected
        accent's MD3 tonal colors (light/dark values in accent_colors.xml).
    -->
    <style name="ThemeOverlay.Horizon.Orange" parent="">
        <item name="colorPrimary">@color/accent_orange_primary</item>
        <item name="colorOnPrimary">@color/accent_orange_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_orange_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_orange_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/accent_orange_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_orange_on_secondary_container</item>
    </style>

