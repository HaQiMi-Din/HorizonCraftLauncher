<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 3 theme (DayNight: dark/light switched via UiTheme.applyTheme) -->
    <style name="AppTheme" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/ui_topbar</item>
        <item name="android:navigationBarColor">@color/ui_bg</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/ui_bg</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>

        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorOnPrimary">@color/ui_on_accent</item>
        <item name="colorPrimaryContainer">@color/ui_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ui_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/ui_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ui_on_secondary_container</item>
        <!-- Explicitly bind the framework text colors to the theme-adaptive ui colors.
             Material3's DayNight textColorPrimary does not reliably switch to the
             light-on-light scheme on every device, which made default text invisible
             in light mode (white on light). Binding them directly to ui_text_* keeps
             text legible in both modes. -->
        <item name="android:textColorPrimary">@color/ui_text_primary</item>
        <item name="android:textColorSecondary">@color/ui_text_secondary</item>
        <item name="android:textColorHint">@color/ui_text_secondary</item>
        <item name="colorSurface">@color/ui_bg</item>
        <item name="colorOnSurface">@color/ui_text_primary</item>
        <item name="colorSurfaceVariant">@color/ui_surface</item>
        <item name="colorOnSurfaceVariant">@color/ui_text_secondary</item>
        <item name="colorError">@color/ui_error</item>

        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="LauncherFragment_Divider">
        <item name="android:layout_width">@dimen/padding_tiny</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="LauncherMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="LauncherMenuButton.Universal" parent="LauncherMenuButton">
        <item name="android:layout_height">@dimen/_66sdp</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1sdp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>

    <item name="dimension_tracker" type="id" />
    <style name="DimensionTracker">
        <item name="android:id">@id/dimension_tracker</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>
</resources>
