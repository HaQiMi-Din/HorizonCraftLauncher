<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_bg">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/_16sdp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terracotta_title"
                android:textSize="@dimen/_22ssp"
                android:textStyle="bold"
                android:textColor="@color/ui_text_primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terracotta_subtitle"
                android:textSize="@dimen/_13ssp"
                android:textColor="@color/ui_text_secondary"/>
        </LinearLayout>
        <Button
            android:id="@+id/terracotta_exit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_secondary"
            android:text="@string/terracotta_exit"
            android:textColor="@color/ui_text_primary"
            android:visibility="gone"
            tools:visibility="visible"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingBottom="@dimen/_20sdp">

            <!-- ============ Status card ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg_border"
                android:padding="@dimen/_16sdp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_status_title"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text_primary"/>
                <TextView
                    android:id="@+id/terracotta_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="@string/terracotta_status_waiting"
                    android:textSize="@dimen/_16ssp"
                    android:textColor="@color/ui_text_primary"/>
                <TextView
                    android:id="@+id/terracotta_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="@dimen/_13ssp"/>
            </LinearLayout>

            <!-- ============ Mode selection ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg_border"
                    android:padding="@dimen/_14sdp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/terracotta_host_title"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold"
                        android:textColor="@color/ui_text_primary"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="@string/terracotta_host_desc"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/ui_text_secondary"/>
                    <Button
                        android:id="@+id/terracotta_host_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/btn_primary"
                        android:text="@string/terracotta_host_create"
                        android:textColor="?attr/colorOnPrimary"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg_border"
                    android:padding="@dimen/_14sdp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/terracotta_guest_title"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold"
                        android:textColor="@color/ui_text_primary"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:text="@string/terracotta_guest_desc"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/ui_text_secondary"/>
                    <Button
                        android:id="@+id/terracotta_guest_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/btn_primary"
                        android:text="@string/terracotta_guest_join"
                        android:textColor="?attr/colorOnPrimary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Host panel ============ -->
            <LinearLayout
                android:id="@+id/terracotta_host_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="vertical"
                android:background="@drawable/card_bg_border"
                android:padding="@dimen/_14sdp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_host_panel_title"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text_primary"/>
                <com.kdt.mcgui.MineEditText
                    android:id="@+id/terracotta_host_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="@string/terracotta_player_name_hint"
                    android:inputType="text"
                    android:singleLine="true"/>
                <Button
                    android:id="@+id/terracotta_host_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/btn_primary"
                    android:text="@string/terracotta_host_create"
                    android:textColor="?attr/colorOnPrimary"/>
                <!-- Invite code shown once the room is up -->
                <TextView
                    android:id="@+id/terracotta_room_code_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/terracotta_room_code_label"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text_primary"
                    android:visibility="gone"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.kdt.mcgui.MineEditText
                        android:id="@+id/terracotta_room_code"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_weight="1"
                        android:focusable="false"
                        android:inputType="text"
                        android:singleLine="true"/>
                    <Button
                        android:id="@+id/terracotta_copy_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/terracotta_copy"
                        android:textColor="@color/ui_text_primary"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="@string/terracotta_host_hint"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/ui_text_secondary"/>
            </LinearLayout>

            <!-- ============ Guest panel ============ -->
            <LinearLayout
                android:id="@+id/terracotta_guest_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="vertical"
                android:background="@drawable/card_bg_border"
                android:padding="@dimen/_14sdp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terracotta_guest_panel_title"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text_primary"/>
                <com.kdt.mcgui.MineEditText
                    android:id="@+id/terracotta_guest_code"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="@string/terracotta_guest_code_hint"
                    android:inputType="text"
                    android:singleLine="true"/>
                <com.kdt.mcgui.MineEditText
                    android:id="@+id/terracotta_guest_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="@string/terracotta_player_name_hint"
                    android:inputType="text"
                    android:singleLine="true"/>
                <Button
                    android:id="@+id/terracotta_guest_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/btn_primary"
                    android:text="@string/terracotta_guest_join"
                    android:textColor="?attr/colorOnPrimary"/>
                <!-- Local join address once connected -->
                <TextView
                    android:id="@+id/terracotta_guest_url_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:text="@string/terracotta_guest_url_label"
                    android:textSize="@dimen/_13ssp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text_primary"
                    android:visibility="gone"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.kdt.mcgui.MineEditText
                        android:id="@+id/terracotta_guest_url"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_weight="1"
                        android:focusable="false"
                        android:inputType="text"
                        android:singleLine="true"/>
                    <Button
                        android:id="@+id/terracotta_copy_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:background="@drawable/btn_secondary"
                        android:text="@string/terracotta_copy"
                        android:textColor="@color/ui_text_primary"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="@string/terracotta_guest_hint"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/ui_text_secondary"/>
            </LinearLayout>

            <!-- Version / node info -->
            <TextView
                android:id="@+id/terracotta_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:gravity="center"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/_12ssp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
