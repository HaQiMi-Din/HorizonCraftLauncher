<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_bg_border"
    android:padding="@dimen/_12sdp"
    android:layout_marginBottom="@dimen/_10sdp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:src="@drawable/ic_edit_profile"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_12sdp">
        <TextView
            android:id="@+id/row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_primary"/>
        <TextView
            android:id="@+id/row_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/ui_text_secondary"/>
    </LinearLayout>

    <Button
        android:id="@+id/row_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_primary"
        android:paddingHorizontal="@dimen/_16sdp"
        android:text="@string/ui_play"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/ui_on_accent"/>
    <Button
        android:id="@+id/row_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/btn_secondary"
        android:paddingHorizontal="@dimen/_16sdp"
        android:text="@string/ui_edit"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/ui_text_primary"/>
    <Button
        android:id="@+id/row_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/btn_secondary"
        android:paddingHorizontal="@dimen/_16sdp"
        android:text="@string/ui_delete"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/ui_text_primary"/>
</LinearLayout>
