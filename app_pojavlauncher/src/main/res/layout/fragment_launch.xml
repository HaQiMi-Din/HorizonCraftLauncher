<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ui_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_16sdp">

        <!-- ============ Left: launch controls ============ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:paddingEnd="@dimen/_16sdp">

            <TextView
                android:id="@+id/launch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_launch_title"
                android:textSize="@dimen/_26ssp"
                android:textStyle="bold"
                android:textColor="@color/ui_text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="@string/ui_brand"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/ui_text_secondary"/>

            <!-- Version selector -->
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/version_spinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_56sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/bg_input"
                android:drawableEnd="@drawable/spinner_arrow"
                android:drawablePadding="@dimen/_8sdp"/>

            <!-- Account -->
            <TextView
                android:id="@+id/launch_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="@string/ui_launch_account_none"
                android:textSize="@dimen/_13ssp"
                android:textColor="@color/ui_text_secondary"/>

            <!-- RAM allocation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_launch_ram"
                    android:textSize="@dimen/_14ssp"
                    android:textColor="@color/ui_text_primary"/>
                <TextView
                    android:id="@+id/ram_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_14ssp"
                    android:textColor="@color/ui_accent"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/ram_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="2048"
                android:min="256"
                android:progress="1024"/>

            <!-- Runtime -->
            <TextView
                android:id="@+id/launch_runtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:textSize="@dimen/_13ssp"
                android:textColor="@color/ui_text_secondary"/>

            <!-- Play button -->
            <Button
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_76sdp"
                android:layout_marginTop="@dimen/_24sdp"
                android:background="@drawable/btn_primary"
                android:text="@string/ui_launch_play"
                android:textSize="@dimen/_18ssp"
                android:textStyle="bold"
                android:textColor="@color/ui_on_accent"/>
        </LinearLayout>

        <!-- ============ Right: info & quick actions ============ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Version info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg_border"
                android:padding="@dimen/_16sdp">
                <TextView
                    android:id="@+id/info_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text_primary"/>
                <TextView
                    android:id="@+id/info_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:textSize="@dimen/_13ssp"
                    android:textColor="@color/ui_text_secondary"/>
            </LinearLayout>

            <!-- Quick actions card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:orientation="vertical"
                android:background="@drawable/card_bg_border"
                android:padding="@dimen/_16sdp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_quick_actions"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    android:textColor="@color/ui_text_primary"/>
                <Button
                    android:id="@+id/quick_edit_profile"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/ui_edit_profile"
                    android:textColor="@color/ui_text_secondary"/>
                <Button
                    android:id="@+id/quick_open_dir"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/ui_open_dir"
                    android:textColor="@color/ui_text_secondary"/>
                <Button
                    android:id="@+id/quick_install_jar"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/ui_install_jar"
                    android:textColor="@color/ui_text_secondary"/>
                <Button
                    android:id="@+id/quick_share_logs"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/ui_share_logs"
                    android:textColor="@color/ui_text_secondary"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
