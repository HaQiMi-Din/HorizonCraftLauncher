<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_bg_border"
    android:padding="@dimen/_12sdp"
    android:layout_marginBottom="@dimen/_10sdp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/acc_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            android:textColor="@color/ui_text_primary"/>
        <TextView
            android:id="@+id/acc_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/ui_text_secondary"/>
    </LinearLayout>

    <TextView
        android:id="@+id/acc_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_12sdp"
        android:textSize="@dimen/_12ssp"
        android:textStyle="bold"
        android:textColor="@color/ui_accent"/>

    <Button
        android:id="@+id/acc_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_primary"
        android:paddingHorizontal="@dimen/_16sdp"
        android:text="@string/ui_account_use"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/ui_on_accent"/>
    <Button
        android:id="@+id/acc_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/btn_secondary"
        android:paddingHorizontal="@dimen/_16sdp"
        android:text="@string/ui_account_logout"
        android:textSize="@dimen/_13ssp"
        android:textColor="@color/ui_text_primary"/>
</LinearLayout>
